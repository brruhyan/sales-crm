FROM dunglas/frankenphp:1-php8.4-bookworm AS base

RUN cp "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini" \
    && install-php-extensions bcmath gd intl pdo_sqlite zip

WORKDIR /app

FROM base AS dependencies

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer
COPY composer.json composer.lock ./
RUN composer install \
    --no-interaction \
    --no-progress \
    --no-scripts \
    --prefer-dist \
    --optimize-autoloader

COPY . .
RUN composer dump-autoload --classmap-authoritative --no-scripts
RUN mkdir -p \
        database \
        storage/framework/cache \
        storage/framework/sessions \
        storage/framework/views \
        bootstrap/cache \
    && touch database/database.sqlite \
    && APP_ENV=production \
       APP_DEBUG=false \
       APP_KEY=base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA= \
       CACHE_STORE=array \
       SESSION_DRIVER=cookie \
       QUEUE_CONNECTION=sync \
       php artisan package:discover --ansi \
    && APP_ENV=production \
       APP_DEBUG=false \
       APP_KEY=base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA= \
       CACHE_STORE=array \
       SESSION_DRIVER=cookie \
       QUEUE_CONNECTION=sync \
       DB_CONNECTION=sqlite \
       DB_DATABASE=/app/database/database.sqlite \
       php artisan migrate --force \
    && APP_ENV=production \
       APP_DEBUG=false \
       APP_KEY=base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA= \
       CACHE_STORE=array \
       SESSION_DRIVER=cookie \
       QUEUE_CONNECTION=sync \
       DB_CONNECTION=sqlite \
       DB_DATABASE=/app/database/database.sqlite \
       php artisan db:seed --force \
    && APP_ENV=production \
       APP_DEBUG=false \
       APP_KEY=base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA= \
       CACHE_STORE=array \
       SESSION_DRIVER=cookie \
       QUEUE_CONNECTION=sync \
       php artisan filament:upgrade --ansi

FROM node:22-bookworm-slim AS assets

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY --from=dependencies /app/vendor /app/vendor
COPY . .
RUN npm run build

FROM base AS runtime

COPY --from=dependencies --chown=www-data:www-data /app /app
COPY --from=assets --chown=www-data:www-data /app/public/build /app/public/build
COPY --chown=www-data:www-data Caddyfile /etc/frankenphp/Caddyfile
COPY --chown=www-data:www-data docker/vercel-entrypoint.sh /usr/local/bin/vercel-entrypoint

RUN chmod +x /usr/local/bin/vercel-entrypoint \
    && mkdir -p \
        storage/framework/cache \
        storage/framework/sessions \
        storage/framework/views \
        bootstrap/cache \
    && chown -R www-data:www-data storage bootstrap/cache /config/caddy /data/caddy

ENV PORT=80 \
    APP_ENV=production \
    APP_DEBUG=false \
    LOG_CHANNEL=stderr \
    DB_CONNECTION=sqlite \
    DB_DATABASE=/tmp/sales-crm.sqlite \
    CACHE_STORE=array \
    SESSION_DRIVER=cookie \
    SESSION_EXPIRE_ON_CLOSE=true \
    SESSION_SECURE_COOKIE=true \
    QUEUE_CONNECTION=sync \
    FILESYSTEM_DISK=local

USER www-data

ENTRYPOINT ["vercel-entrypoint"]
CMD ["frankenphp", "run", "--config", "/etc/frankenphp/Caddyfile"]
